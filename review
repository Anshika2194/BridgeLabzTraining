-- Display all employees
SELECT * FROM Employee;

-- Display only employee names
SELECT name FROM Employee;

-- Employees with salary greater than 50000
SELECT * FROM Employee
WHERE salary > 50000;

-- Employees from Pune
SELECT * FROM Employee
WHERE city = 'Pune';

-- Employees whose age is between 25 and 30
SELECT * FROM Employee
WHERE age BETWEEN 25 AND 30;

-- Employees whose name starts with 'A'
SELECT * FROM Employee
WHERE name LIKE 'A%';

-- Employees whose salary is NULL
SELECT * FROM Employee
WHERE salary IS NULL;

-- Sort employees by salary (ascending)
SELECT * FROM Employee
ORDER BY salary ASC;

-- Sort employees by salary (descending)
SELECT * FROM Employee
ORDER BY salary DESC;

-- Display first 5 employees
SELECT * FROM Employee
LIMIT 5;

-- Highest salary
SELECT MAX(salary) AS highest_salary
FROM Employee;

-- Second highest salary
SELECT MAX(salary) AS second_highest_salary
FROM Employee
WHERE salary < (
    SELECT MAX(salary)
    FROM Employee
);

-- Third highest salary
SELECT DISTINCT salary
FROM Employee
ORDER BY salary DESC
LIMIT 2,1;

-- Average salary
SELECT AVG(salary) AS average_salary
FROM Employee;

-- Total salary
SELECT SUM(salary) AS total_salary
FROM Employee;

-- Lowest salary
SELECT MIN(salary) AS lowest_salary
FROM Employee;

-- Total number of employees
SELECT COUNT(*) AS total_employees
FROM Employee;

-- Distinct departments
SELECT DISTINCT department
FROM Employee;

-- Employees from IT department
SELECT * FROM Employee
WHERE department = 'IT';

-- Employees from Pune with salary > 50000
SELECT * FROM Employee
WHERE city = 'Pune'
AND salary > 50000;

-- Employee name with department name (JOIN)
SELECT e.name,
       d.department_name
FROM Employee e
INNER JOIN Department d
ON e.manager_id = d.department_id;

-- Employee name only using JOIN
SELECT e.name
FROM Employee e
INNER JOIN Department d
ON e.manager_id = d.department_id;

-- Employee name and salary using JOIN
SELECT e.name,
       e.salary
FROM Employee e
INNER JOIN Department d
ON e.manager_id = d.department_id;

-- Employees ordered by joining date
SELECT * FROM Employee
ORDER BY joining_date ASC;

-- Latest joined employee
SELECT * FROM Employee
ORDER BY joining_date DESC
LIMIT 1;